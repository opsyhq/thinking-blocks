# Copy to .env (gitignored) and fill in. The get/verify scripts auto-load .env
# from this directory.

# Read by the @ai-sdk/openai provider in src/get.ts (the `get` script).
# Not needed for `dev` (reads the local store file) or `verify` (mock model).
OPENAI_API_KEY=sk-...

# Optional: override the model id (default gpt-4o-mini).
# TB_MODEL=gpt-4o-mini
