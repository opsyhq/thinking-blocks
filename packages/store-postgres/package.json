{
	"name": "@thinking-blocks/store-postgres",
	"version": "0.1.0",
	"description": "Postgres (Drizzle) implementation of the Thinking Blocks store: durable, versioned artifacts with audit queries.",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"drizzle"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@thinking-blocks/store": "workspace:*",
		"@thinking-blocks/core": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"drizzle-kit": "^0.31.10",
		"zod": "^4.4.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
