{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thinking-blocks",
	"compatibility_date": "2026-06-01",
	// Serve from the apex domain. `custom_domain` makes Cloudflare provision the
	// DNS record + edge cert for this zone automatically on deploy.
	"routes": [{ "pattern": "thinkingblocks.dev", "custom_domain": true }],
	// Static-assets-only Worker: no server code, just the Next.js `output: "export"`
	// directory served from Cloudflare's edge. `pnpm build` regenerates ./out.
	"assets": {
		"directory": "./out",
		// `/docs` -> docs.html, `/docs/quickstart` -> docs/quickstart.html, etc.
		"html_handling": "auto-trailing-slash",
		// On a miss, serve the prerendered Next.js 404 page.
		"not_found_handling": "404-page"
	}
}
